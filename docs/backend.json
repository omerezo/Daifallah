{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user in the UmmaTech Aid application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user profile, matching Firebase Auth UID."
        },
        "name": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "description": "The user's email address.",
          "format": "email"
        },
        "role": {
          "type": "string",
          "description": "The user's role within the system.",
          "enum": ["Admin", "Manager", "Collector", "Viewer"]
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "role"
      ]
    },
    "Payment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Payment",
      "type": "object",
      "description": "Represents a payment made to the charity.",
      "properties": {
        "participantId": {
          "type": "string",
          "description": "Reference to the Participant's ID."
        },
        "participantName": {
          "type": "string",
          "description": "Denormalized name of the participant for display."
        },
        "date": {
          "type": "string",
          "description": "Date of the payment.",
          "format": "date-time"
        },
        "amount": {
          "type": "number",
          "description": "Amount of the payment."
        },
        "currency": {
          "type": "string",
          "description": "Currency of the payment.",
          "enum": ["USD", "SAR", "EGP", "SDG"]
        },
        "type": {
          "type": "string",
          "description": "Type of payment.",
          "enum": ["Monthly Share", "Donation"]
        },
        "paymentFor": {
          "type": "string",
          "description": "The month and year the payment is for (e.g., 'May 2024')."
        },
        "recordedBy": {
          "type": "string",
          "description": "The UID of the user who recorded the payment."
        },
        "remarks": {
          "type": "string",
          "description": "Optional remarks about the payment."
        }
      },
      "required": [
        "participantId",
        "participantName",
        "date",
        "amount",
        "currency",
        "type",
        "paymentFor",
        "recordedBy"
      ]
    },
    "Participant": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Participant",
      "type": "object",
      "description": "Represents a participant in the charity.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the participant."
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the participant."
        },
        "monthlyShare": {
          "type": "string",
          "description": "Monthly share amount and currency (e.g., '100 USD')."
        },
        "status": {
          "type": "string",
          "description": "Status of the participant.",
          "enum": ["Active", "Inactive"]
        },
        "lastPaymentDate": {
          "type": "string",
          "description": "Last payment date of the participant.",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "phone",
        "monthlyShare",
        "status"
      ]
    },
    "Expense": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Expense",
      "type": "object",
      "description": "Represents an expense incurred by the charity.",
      "properties": {
        "date": {
          "type": "string",
          "description": "Date of the expense.",
          "format": "date-time"
        },
        "description": {
          "type": "string",
          "description": "Description of the expense."
        },
        "category": {
          "type": "string",
          "description": "Category of the expense.",
          "enum": ["Family Support", "Medical", "Education", "Operational"]
        },
        "amount": {
          "type": "number",
          "description": "Amount of the expense."
        },
        "currency": {
          "type": "string",
          "description": "Currency of the expense.",
           "enum": ["USD", "SAR", "EGP", "SDG"]
        },
        "recordedBy": {
          "type": "string",
          "description": "The UID of the user who recorded the expense."
        }
      },
      "required": [
        "date",
        "description",
        "category",
        "amount",
        "currency",
        "recordedBy"
      ]
    },
    "Wallet": {
      "title": "Wallet",
      "type": "object",
      "description": "Represents a financial wallet or fund.",
      "properties": {
        "name": {"type": "string"},
        "remarks": {"type": "string"},
        "balance": {"type": "number"},
        "currency": {"type": "string", "enum": ["USD", "SAR", "EGP", "SDG"]}
      },
      "required": ["name", "balance", "currency"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "type": "object",
      "description": "A transaction associated with a wallet.",
      "properties": {
        "walletId": {"type": "string"},
        "date": {"type": "string", "format": "date-time"},
        "type": {"type": "string", "enum": ["add", "consume"]},
        "amount": {"type": "number"},
        "description": {"type": "string"}
      },
      "required": ["walletId", "date", "type", "amount", "description"]
    },
    "PolicyDocument": {
      "title": "PolicyDocument",
      "type": "object",
      "description": "A policy or procedure document.",
      "properties": {
        "name": {"type": "string"},
        "details": {"type": "string"},
        "uploadedAt": {"type": "string", "format": "date-time"}
      },
      "required": ["name", "uploadedAt"]
    },
    "Letter": {
      "title": "Letter",
      "type": "object",
      "description": "Represents an official letter generated by the system.",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "header": { "type": "string" },
        "body": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["date", "header", "body", "createdAt", "createdBy"]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/entities/User"
          },
          "description": "Stores user profile information, including their role."
        }
      },
      {
        "path": "/participants/{participantId}",
        "definition": {
          "entityName": "Participant",
          "schema": {
            "$ref": "#/entities/Participant"
          },
          "description": "Stores information about charity participants."
        }
      },
      {
        "path": "/payments/{paymentId}",
        "definition": {
          "entityName": "Payment",
          "schema": {
            "$ref": "#/entities/Payment"
          },
          "description": "Stores all payment records."
        }
      },
      {
        "path": "/expenses/{expenseId}",
        "definition": {
          "entityName": "Expense",
          "schema": {
            "$ref": "#/entities/Expense"
          },
          "description": "Stores all expense records."
        }
      },
       {
        "path": "/wallets/{walletId}",
        "definition": {
          "entityName": "Wallet",
          "schema": {
            "$ref": "#/entities/Wallet"
          },
          "description": "Stores all financial wallets."
        }
      },
      {
        "path": "/walletTransactions/{transactionId}",
        "definition": {
          "entityName": "WalletTransaction",
          "schema": {
            "$ref": "#/entities/WalletTransaction"
          },
          "description": "Stores all wallet transactions."
        }
      },
      {
        "path": "/policyDocuments/{documentId}",
        "definition": {
          "entityName": "PolicyDocument",
          "schema": {
            "$ref": "#/entities/PolicyDocument"
          },
          "description": "Stores all policy and procedure documents."
        }
      },
      {
        "path": "/letters/{letterId}",
        "definition": {
          "entityName": "Letter",
          "schema": {
            "$ref": "#/entities/Letter"
          },
          "description": "Stores all official generated letters."
        }
      }
    ]
  }
}
