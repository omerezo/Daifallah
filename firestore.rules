
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Allow public read for app configuration like the logo
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isSignedIn(); // Only signed-in users can change config
    }

    // Allow signed-in users to manage their own profile and read others'
    match /users/{userId} {
      allow read, list: if isSignedIn();
      allow create: if request.auth.uid == userId; // User can create their own profile
      allow update: if request.auth.uid == userId; // User can update their own profile
      allow delete: if isSignedIn(); // Any signed-in user can delete another for now
    }

    // Allow any signed-in user full access to the main data collections
    match /participants/{participantId} {
      allow read, write: if isSignedIn();
    }
    
    match /payments/{paymentId} {
        allow read, write: if isSignedIn();
    }

    match /expenses/{expenseId} {
        allow read, write: if isSignedIn();
    }
    
    match /wallets/{walletId} {
        allow read, write: if isSignedIn();
    }

    match /walletTransactions/{transactionId} {
        allow read, write: if isSignedIn();
    }

    match /policyDocuments/{documentId} {
        allow read, write: if isSignedIn();
    }

    match /letters/{letterId} {
      allow read, write: if isSignedIn();
    }
  }
}
