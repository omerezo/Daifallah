rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for concise, reusable logic.
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole(request.auth.uid) == 'Admin';
    }

    function isManager() {
      return isSignedIn() && (getUserRole(request.auth.uid) == 'Manager' || isAdmin());
    }

    function isCollector() {
        return isSignedIn() && (getUserRole(request.auth.uid) == 'Collector' || isManager());
    }
    
    function isViewer() {
        return isSignedIn(); // All signed in users can view
    }

    // USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // PARTICIPANTS
    match /participants/{participantId} {
      allow read: if isViewer();
      allow list: if isViewer();
      allow create: if isCollector();
      allow update: if isCollector();
      allow delete: if isAdmin();
    }
    
    // PAYMENTS
    match /payments/{paymentId} {
        allow read, list: if isViewer();
        allow create: if isCollector() && request.resource.data.recordedBy == request.auth.uid;
        allow update: if (isCollector() && resource.data.recordedBy == request.auth.uid) || isManager();
        allow delete: if (isCollector() && resource.data.recordedBy == request.auth.uid) || isAdmin();
    }

    // EXPENSES
    match /expenses/{expenseId} {
        allow read, list: if isViewer();
        allow create: if isCollector() && request.resource.data.recordedBy == request.auth.uid;
        allow update: if (isCollector() && resource.data.recordedBy == request.auth.uid) || isManager();
        allow delete: if (isCollector() && resource.data.recordedBy == request.auth.uid) || isAdmin();
    }
    
    // WALLETS
    match /wallets/{walletId} {
        allow read, list: if isManager();
        allow create, update, delete: if isAdmin();
    }

    // WALLET TRANSACTIONS
    match /walletTransactions/{transactionId} {
        allow read, list: if isManager();
        allow create: if isManager();
        allow update, delete: if isAdmin();
    }

    // POLICY DOCUMENTS
    match /policyDocuments/{documentId} {
        allow read, list: if isViewer();
        allow create, delete: if isAdmin();
    }
  }
}
